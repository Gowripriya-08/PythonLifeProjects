# abstract class
from abc import ABC,abstractmethod
class abstract_demo(ABC):
    @abstractmethod
    def display(self):
        pass
    def display2(self):
        pass

class demo(abstract_demo):
    def display(self):
        print('this is amazing')
    def display2(self):
        print("i love it")
obj = demo()
obj.display()
obj.display2()


